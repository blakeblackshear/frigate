      "enum": [
        "cpu",
        "cuda",
        "tensorrt",
        "migraphx",
        "openvino_cpu",
        "openvino_gpu",
        "openvino_npu",
        "other"
      ],
      "title": "EnrichmentDevice",
      "type": "string"
    },
    "EnrichmentTiming": {
      "enum": [
        "face",
        "lpr",
        "plate_detection",
        "image_embedding",
        "text_embedding",
        "review_description",
        "object_description"
      ],
      "title": "EnrichmentTiming",
      "type": "string"
    },
    "EnrichmentUsage": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnrichmentDevice"
