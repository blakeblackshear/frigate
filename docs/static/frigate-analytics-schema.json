        "enabled": {
          "description": "Whether birdseye is on",
          "title": "Enabled",
          "type": "boolean",
          "x-public": true
        },
        "modes": {
          "description": "Birdseye modes",
          "items": {
            "$ref": "#/$defs/BirdseyeModeEnum"
          },
          "title": "Modes",
          "type": "array",
          "x-public": true
        },
        "restream": {
          "description": "Whether birdseye is restreamed",
          "title": "Restream",
          "type": "boolean",
          "x-public": true
        }
      },
      "required": [
        "enabled",
        "modes",
        "restream"
      ],
      "title": "BirdseyeUsage",
      "type": "object"
    },
    "CameraTypeEnum": {
      "enum": [
        "generic",
        "lpr"
