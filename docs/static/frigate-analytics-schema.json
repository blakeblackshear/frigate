          "description": "Cameras with GenAI object descriptions on",
          "minimum": 0,
          "title": "Object Genai",
          "type": "integer",
          "x-public": true
        },
        "object_masks": {
          "description": "Object masks across cameras",
          "minimum": 0,
          "title": "Object Masks",
          "type": "integer",
          "x-public": true
        },
        "onvif": {
          "description": "Cameras with an ONVIF host",
          "minimum": 0,
          "title": "Onvif",
          "type": "integer",
          "x-public": true
        },
        "record": {
          "description": "Cameras with recording on",
          "minimum": 0,
          "title": "Record",
          "type": "integer",
          "x-public": true
        },
        "retain_days": {
          "$ref": "#/$defs/RetainDays",
