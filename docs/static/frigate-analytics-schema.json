      "enum": [
        "axengine",
        "cpu",
        "deepx",
        "edgetpu",
        "hailo",
        "memryx",
        "onnx",
        "openvino",
        "rknn",
        "synaptics",
        "teflon_tfl",
        "tensorrt",
        "zmq"
      ],
