    "ClassificationUsage": {
      "additionalProperties": false,
      "properties": {
        "object": {
          "description": "Custom object classification models",
          "minimum": 0,
          "title": "Object",
          "type": "integer",
          "x-public": true
        },
        "state": {
          "description": "Custom state classification models",
          "minimum": 0,
          "title": "State",
          "type": "integer",
          "x-public": true
        }
      },
      "required": [
        "state",
        "object"
      ],
