          "x-public": true
        },
        "enabled": {
          "description": "Whether the enrichment is on",
          "title": "Enabled",
          "type": "boolean",
          "x-public": true
        },
        "model_size": {
          "$ref": "#/$defs/ModelSizeEnum",
          "description": "Configured model size",
          "x-public": true
        }
      },
      "required": [
        "enabled",
        "model_size",
        "device"
      ],
      "title": "EnrichmentUsage",
      "type": "object"
    },
    "FeaturesSection": {
      "additionalProperties": false,
