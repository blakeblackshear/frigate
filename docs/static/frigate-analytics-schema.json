          "x-public": true
        }
      },
      "required": [
        "vendor",
        "name"
      ],
      "title": "GpuInfo",
      "type": "object"
    },
    "GpuVendor": {
      "enum": [
        "intel",
        "amd",
        "nvidia",
        "rockchip",
        "rpi",
        "other"
      ],
