      "type": "string"
    },
    "HardwareKey": {
      "enum": [
        "edgetpu:pci",
        "edgetpu:usb",
        "openvino:GPU",
        "openvino:NPU",
        "onnx:amd",
        "onnx:nvidia",
        "tensorrt",
        "hailo",
        "memryx",
        "deepx",
        "rknn",
        "axengine",
        "synaptics",
        "cpu",
